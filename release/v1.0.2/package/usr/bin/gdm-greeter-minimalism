PY
}

write_dropin_file() {
    local file="$1"

    python3 - "${file}" "$(overlay_env)" <<'PY'
import os
import pathlib
import sys

dropin_file = pathlib.Path(sys.argv[1])
overlay = sys.argv[2]
content = f"""[Service]\nEnvironment=G_RESOURCE_OVERLAYS={overlay}\n"""
pending = dropin_file.with_name(f".{dropin_file.name}.ggm-{os.getpid()}")
pending.write_text(content, encoding="utf-8")
pending.chmod(0o644)
os.replace(pending, dropin_file)
PY
}

write_dropins() {
    local gdm_dir
    gdm_dir="$(gdm_dropin_dir)"

    install -d -m755 "${user_shell_dropin_dir}" "${gdm_service_dropin_dir}" "${gdm_dir}"
    write_dropin_file "${user_shell_dropin_file}"
    write_dropin_file "${gdm_service_dropin_file}"
    write_dropin_file "$(gdm_dropin_file)"
    chown -R gdm:gdm "${gdm_dir}"
    systemctl daemon-reload
}

verify_overlay_resources() {
    local env_value
    local mode="${1:-installed}"
    local target_root="${2:-${overlay_root}}"
    local overlay_root="${target_root}"
    env_value="$(overlay_env)"

    if [[ "${mode}" == "installed" ]]; then
        [[ -f "${user_shell_dropin_file}" ]] || die "User-Shell-Drop-in fehlt: ${user_shell_dropin_file}"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "${user_shell_dropin_file}" >/dev/null || die "User-Shell-Drop-in enthält kein G_RESOURCE_OVERLAYS."
        [[ -f "${gdm_service_dropin_file}" ]] || die "GDM-Service-Drop-in fehlt: ${gdm_service_dropin_file}"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "${gdm_service_dropin_file}" >/dev/null || die "GDM-Service-Drop-in enthält kein G_RESOURCE_OVERLAYS."
        [[ -f "$(gdm_dropin_file)" ]] || die "GDM-Drop-in fehlt: $(gdm_dropin_file)"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "$(gdm_dropin_file)" >/dev/null || die "GDM-Drop-in enthält kein G_RESOURCE_OVERLAYS."
    fi
    [[ -f "$(overlay_session_file)" ]] || die "Overlay-Datei fehlt: $(overlay_session_file)"
    [[ -f "$(overlay_panel_file)" ]] || die "Overlay-Datei fehlt: $(overlay_panel_file)"
    [[ -f "$(overlay_system_actions_file)" ]] || die "Overlay-Datei fehlt: $(overlay_system_actions_file)"
    [[ -f "$(overlay_screen_shield_file)" ]] || die "Overlay-Datei fehlt: $(overlay_screen_shield_file)"
    [[ -f "$(overlay_unlock_file)" ]] || die "Overlay-Datei fehlt: $(overlay_unlock_file)"
    [[ -f "$(overlay_auth_prompt_file)" ]] || die "Overlay-Datei fehlt: $(overlay_auth_prompt_file)"
    [[ -f "$(overlay_login_file)" ]] || die "Overlay-Datei fehlt: $(overlay_login_file)"
    [[ -f "$(overlay_theme_file)" ]] || die "Overlay-Datei fehlt: $(overlay_theme_file)"
    [[ -f "$(overlay_theme_source_file)" ]] || die "Overlay-Theme-Quelle fehlt: $(overlay_theme_source_file)"
    if [[ "${mode}" == "installed" ]]; then
        grep -F "Exec=env G_RESOURCE_OVERLAYS=${env_value} gnome-session" "${greeter_desktop_file}" >/dev/null || die "Greeter-Desktop lädt kein G_RESOURCE_OVERLAYS."
    fi

    grep -F "'unlock-dialog': {" "$(overlay_session_file)" >/dev/null || die "unlock-dialog-Override fehlt."
    grep -F "'gdm': {" "$(overlay_session_file)" >/dev/null || die "gdm-Override fehlt."
    grep -F "Main.sessionMode.isLocked" "$(overlay_panel_file)" >/dev/null || die "panel-Override für unlock-dialog fehlt."
    grep -F "this._actions.get(LOCK_SCREEN_ACTION_ID).available = showLock;" "$(overlay_system_actions_file)" >/dev/null || die "systemActions-Lock-Button-Override fehlt."
    grep -F "Main.screenShield.switchToGreeter();" "$(overlay_system_actions_file)" >/dev/null || die "systemActions-Greeter-Action-Override fehlt."
    grep -F "switchToGreeter()" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Methode fehlt."
    grep -F "this._lockSettings.get_boolean(DISABLE_LOCK_KEY)" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Lockdown-Override fehlt."
    grep -F "this.switchToGreeter();" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Suspend-Greeter-Override fehlt."
    grep -F "org.gnome.DisplayManager.LocalDisplayFactory" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Interface-Override fehlt."
    grep -F "CreateTransientDisplay" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Method-Override fehlt."
    grep -F "this._greeterSwitchTimeoutId = GLib.timeout_add(" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Dedupe-Override fehlt."
    grep -F "St.Clipboard.get_default().set_text(St.ClipboardType.CLIPBOARD, '')" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Clipboard-Override fehlt."
    grep -F "St.Clipboard.get_default().set_text(St.ClipboardType.PRIMARY, '')" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Primary-Clipboard-Override fehlt."
    grep -F "Gio.DBus.system.call(" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-DBus-Override fehlt."
    grep -F "this._activePage = this._promptBox;" "$(overlay_unlock_file)" >/dev/null || die "unlockDialog-Prompt-Override fehlt."
    grep -F "this._showPrompt();" "$(overlay_unlock_file)" >/dev/null || die "unlockDialog-Fail-Override fehlt."
    grep -F "this._userWell.set_child(null);" "$(overlay_auth_prompt_file)" >/dev/null || die "authPrompt-Avatar-Override fehlt."
    grep -F "this._bottomButtonGroup.hide();" "$(overlay_login_file)" >/dev/null || die "loginDialog-Override fehlt."
    grep -F "const cancelVisible = this._authPrompt._entry === this._authPrompt._passwordEntry;" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Eingabetyp-Override fehlt."
    grep -F "this._updateCancelButton();" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Zustandsaktualisierung fehlt."
    grep -F "this._authPrompt.cancelButton.opacity = cancelVisible ? 255 : 0;" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Layout-Override fehlt."
    grep -F "actor === this._authPrompt" "$(overlay_login_file)" >/dev/null || die "loginDialog-Zentrierungs-Override fehlt."
    grep -F "background-color: ${greeter_background_color};" "$(overlay_theme_file)" >/dev/null || die "Theme-Override nutzt nicht die Greeter-Hintergrundfarbe."
    grep -F -- "-st-accent-color: ${greeter_focus_accent_color};" "$(overlay_theme_file)" >/dev/null || die "Theme-Override nutzt nicht die neutrale Fokusfarbe."
    grep -F "st-mix(-st-accent-color" "$(overlay_theme_file)" >/dev/null && die "Theme-Override enthält noch dynamische Fokus-Akzentfarbe."
    if [[ "${mode}" == "installed" ]]; then
        [[ -f "${gdm_input_state}" ]] || die "GDM-Input-State fehlt."
        [[ -f "${gdm_background_state}" ]] || die "GDM-Background-State fehlt."
        [[ -f "${gdm_accent_state}" ]] || die "GDM-Accent-State fehlt."
        grep -F "${greeter_background_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Background-Override fehlt."
        grep -F "background-color='${greeter_background_color}'" "${greeter_dconf_file}" >/dev/null || die "Greeter-Background nutzt nicht die Greeter-Hintergrundfarbe."
        grep -F "${greeter_accent_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Accent-Override fehlt."
        grep -F "accent-color=${greeter_accent_color}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Accent ist nicht neutral."
        grep -F "${greeter_input_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Input-Override fehlt."
        grep -F "sources=" "${greeter_dconf_file}" >/dev/null || die "Greeter-Sources fehlen."
    fi

    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/sessionMode.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes(\"'gdm': {\\n        hasNotifications: false,\") || !text.includes(\"'unlock-dialog': {\\n        hasNotifications: false,\") || !text.includes(\"'user': {\") || !text.includes(\"        hasNotifications: true,\") || !text.includes(\"panelStyle: null,\") || !text.includes(\"right: ['keyboard'],\")) throw new Error('sessionMode lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/panel.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('Main.layoutManager.panelBox.hide();') || !text.includes('Main.sessionMode.isLocked') || text.includes('const hasVisibleItems =')) throw new Error('panel lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/misc/systemActions.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._actions.get(LOCK_SCREEN_ACTION_ID).available = showLock;') || !text.includes('Main.screenShield.switchToGreeter();') || text.includes('showLock && allowLockScreen') || text.includes('Main.screenShield.lock(true);')) throw new Error('systemActions lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/screenShield.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('switchToGreeter()') || !text.includes('this.switchToGreeter();') || !text.includes('org.gnome.DisplayManager.LocalDisplayFactory') || !text.includes('CreateTransientDisplay') || !text.includes('this._greeterSwitchTimeoutId = GLib.timeout_add(') || !text.includes(\"St.Clipboard.get_default().set_text(St.ClipboardType.CLIPBOARD, '')\") || !text.includes(\"St.Clipboard.get_default().set_text(St.ClipboardType.PRIMARY, '')\") || !text.includes('Gio.DBus.system.call(') || text.includes('Util.spawn([') || text.includes('this.lock(true);') || text.includes('Screen lock is locked down')) throw new Error('screenShield lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/unlockDialog.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._activePage = this._promptBox;') || !text.includes('this._adjustment.value = 1;') || text.includes('this._showClock();\\n\\n        this.allowCancel = false;')) throw new Error('unlockDialog lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/gdm/authPrompt.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._userWell.set_child(null);') || !text.includes('visible: false,')) throw new Error('authPrompt lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/gdm/loginDialog.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._bottomButtonGroup.hide();') || !text.includes('this._a11yMenuButton = null;') || !text.includes('const cancelVisible = this._authPrompt._entry === this._authPrompt._passwordEntry;') || !text.includes('this._authPrompt.cancelButton.reactive = cancelVisible;') || !text.includes('this._updateCancelButton();') || !text.includes('this._authPrompt.cancelButton.opacity = cancelVisible ? 255 : 0;') || !text.includes('actor === this._authPrompt') || !text.includes('centerY - anchorHeight / 2')) throw new Error('loginDialog lookup fehlgeschlagen');"
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/theme/gdm.css', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('#lockDialogGroup {') || !text.includes('background-color: ${greeter_background_color};') || !text.includes('background-color: #353535;') || !text.includes('-st-accent-color: ${greeter_focus_accent_color};') || text.includes('st-mix(-st-accent-color')) throw new Error('theme lookup fehlgeschlagen');"
}

record_refresh_failure() {
    local detail="$1"
    local gdm_version
    local shell_version
    gdm_version="$(dpkg-query -W -f='${Version}' gdm3 2>/dev/null || printf 'unbekannt')"
    shell_version="$(dpkg-query -W -f='${Version}' gnome-shell 2>/dev/null || printf 'unbekannt')"

    install -d -m755 "${runtime_root}"
    python3 - "${failure_state}" "${gdm_version}" "${shell_version}" "${detail}" <<'PY'
import json
import pathlib
import sys
import uuid

gdm_version = sys.argv[2]
shell_version = sys.argv[3]
detail = " ".join(sys.argv[4].split())
path = pathlib.Path(sys.argv[1])
identity = uuid.uuid4().hex
if path.is_file():
    current = json.loads(path.read_text(encoding="utf-8"))
    if (
        current.get("detail") == detail
        and current.get("gdm_version") == gdm_version
        and current.get("gnome_shell_version") == shell_version
    ):
        identity = current["id"]
state = {
    "id": identity,
    "summary": "GDM-Anpassung deaktiviert",
    "body": (
        "Das installierte GDM-/GNOME-Update ist nicht kompatibel. "
        "GDM verwendet die Stock-Oberfläche. "
        "Details stehen in /var/lib/gdm-greeter-minimalism/failure.json."
    ),
    "detail": detail,
    "gdm_version": gdm_version,
    "gnome_shell_version": shell_version,
}
path.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
path.chmod(0o644)
PY
}

clear_refresh_failure() {
    rm -f "${failure_state}"
}

write_stock_overlay() {
    local target_root="$1"
    local active_theme
    active_theme="$(active_theme_path)"

    install -d -m755 "${target_root}/ui" "${target_root}/gdm" "${target_root}/misc" "${target_root}/theme"
    python3 - "${shell_resource}" "${active_theme}" "${target_root}" <<'PY'
import pathlib
import subprocess
import sys

shell_resource = pathlib.Path(sys.argv[1])
theme_resource = pathlib.Path(sys.argv[2])
target_root = pathlib.Path(sys.argv[3])
resources = {
    "ui/sessionMode.js": (shell_resource, "/org/gnome/shell/ui/sessionMode.js"),
    "ui/panel.js": (shell_resource, "/org/gnome/shell/ui/panel.js"),
    "misc/systemActions.js": (shell_resource, "/org/gnome/shell/misc/systemActions.js"),
    "ui/screenShield.js": (shell_resource, "/org/gnome/shell/ui/screenShield.js"),
    "ui/unlockDialog.js": (shell_resource, "/org/gnome/shell/ui/unlockDialog.js"),
    "gdm/authPrompt.js": (shell_resource, "/org/gnome/shell/gdm/authPrompt.js"),
    "gdm/loginDialog.js": (shell_resource, "/org/gnome/shell/gdm/loginDialog.js"),
    "theme/gdm.css": (theme_resource, "/org/gnome/shell/theme/gdm.css"),
}

for relative_path, (resource_file, resource_path) in resources.items():
    content = subprocess.check_output(
        ["gresource", "extract", str(resource_file), resource_path]
    )
    (target_root / relative_path).write_bytes(content)
PY
}

verify_stock_overlay() {
    local target_root="$1"
    local active_theme
    local env_value="/org/gnome/shell=${target_root}"
    active_theme="$(active_theme_path)"

    python3 - "${shell_resource}" "${active_theme}" "${target_root}" <<'PY'
import pathlib
import subprocess
import sys

shell_resource = pathlib.Path(sys.argv[1])
theme_resource = pathlib.Path(sys.argv[2])
target_root = pathlib.Path(sys.argv[3])
resources = {
    "ui/sessionMode.js": (shell_resource, "/org/gnome/shell/ui/sessionMode.js"),
    "ui/panel.js": (shell_resource, "/org/gnome/shell/ui/panel.js"),
    "misc/systemActions.js": (shell_resource, "/org/gnome/shell/misc/systemActions.js"),
    "ui/screenShield.js": (shell_resource, "/org/gnome/shell/ui/screenShield.js"),
    "ui/unlockDialog.js": (shell_resource, "/org/gnome/shell/ui/unlockDialog.js"),
    "gdm/authPrompt.js": (shell_resource, "/org/gnome/shell/gdm/authPrompt.js"),
    "gdm/loginDialog.js": (shell_resource, "/org/gnome/shell/gdm/loginDialog.js"),
    "theme/gdm.css": (theme_resource, "/org/gnome/shell/theme/gdm.css"),
}

for relative_path, (resource_file, resource_path) in resources.items():
    expected = subprocess.check_output(
        ["gresource", "extract", str(resource_file), resource_path]
    )
    actual = (target_root / relative_path).read_bytes()
    if actual != expected:
        raise SystemExit(f"Stock-Ressource stimmt nicht überein: {relative_path}")
PY

    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; for (const path of ['/org/gnome/shell/ui/sessionMode.js', '/org/gnome/shell/ui/panel.js', '/org/gnome/shell/misc/systemActions.js', '/org/gnome/shell/ui/screenShield.js', '/org/gnome/shell/ui/unlockDialog.js', '/org/gnome/shell/gdm/authPrompt.js', '/org/gnome/shell/gdm/loginDialog.js', '/org/gnome/shell/theme/gdm.css']) { const data = Gio.resources_lookup_data(path, 0); if (data.get_size() === 0) throw new Error('Leere Stock-Ressource: ' + path); }"
}

prepare_stock_release() {
    local fingerprint
    local release_root
    local candidate
    local output

    fingerprint="$(stock_fingerprint)"
    release_root="${stock_releases}/${fingerprint}"

    if [[ -d "${release_root}" ]]; then
        if output="$(verify_stock_overlay "${release_root}" 2>&1)"; then
            prepared_stock="${release_root}"
            printf '%s\n' "${release_root}" >"${stock_overlay_state}"
            chmod 644 "${stock_overlay_state}"
            return 0
        fi
        refresh_error="${output}"
        return 1
    fi

    candidate="${candidate_root}/stock-${fingerprint}-${BASHPID}"
    if ! output="$(
        (
            write_stock_overlay "${candidate}"
            verify_stock_overlay "${candidate}"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi

    install -d -m755 "${stock_releases}"
    mv -- "${candidate}" "${release_root}"
    prepared_stock="${release_root}"
    printf '%s\n' "${release_root}" >"${stock_overlay_state}"
    chmod 644 "${stock_overlay_state}"
}

switch_overlay() {
    local target="$1"
    local pending_link="${overlay_base}/.active-${BASHPID}"

    install -d -m755 "${overlay_base}" "${target}"
    ln -s -- "${target}" "${pending_link}"
    mv -Tf -- "${pending_link}" "${overlay_root}"
}

deactivate_system_integration() {
    if [[ -z "${prepared_stock}" ]]; then
        prepare_stock_release || die "Stock-Overlay konnte nicht vorbereitet werden: ${refresh_error}"
    fi
    switch_overlay "${prepared_stock}"
    rm -f "${user_shell_dropin_file}" "${gdm_service_dropin_file}" "$(gdm_dropin_file)"
    restore_greeter_desktop_environment
    systemctl daemon-reload
}

prepare_overlay_release() {
    local fingerprint
    local release_root
    local candidate
    local output

    fingerprint="$(overlay_fingerprint)"
    release_root="${overlay_releases}/${fingerprint}"

    if [[ -d "${release_root}" ]]; then
        if output="$(
            (
                verify_overlay_resources generated "${release_root}"
            ) 2>&1
        )"; then
            prepared_overlay="${release_root}"
            return 0
        fi
        refresh_error="${output}"
        return 1
    fi

    candidate="${candidate_root}/${fingerprint}-${BASHPID}"
    if ! output="$(
        (
            write_overlay_sources "${candidate}"
            verify_overlay_resources generated "${candidate}"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi

    install -d -m755 "${overlay_releases}"
    mv -- "${candidate}" "${release_root}"
    prepared_overlay="${release_root}"
}

activate_overlay_release() {
    local release_root="$1"

    switch_overlay "${release_root}"
    printf '%s\n' "${release_root}" >"${active_overlay_state}"
    chmod 644 "${active_overlay_state}"
    write_dropins
    apply_greeter_desktop_environment
    verify_overlay_resources
    rm -f "${greeter_desktop_state}"
}

refresh_override() {
    write_runtime_state
    print_step "Stock-Overlay prüfen"
    if ! prepare_stock_release; then
        [[ -n "${refresh_error}" ]] || refresh_error="Stock-Overlay konnte nicht erzeugt oder geprüft werden."
        printf '%s\n' "${refresh_error}" >&2
        die "Sicherer Stock-Zustand konnte nicht vorbereitet werden."
    fi

    print_step "Kompatibilität prüfen"
    if ! prepare_overlay_release; then
        [[ -n "${refresh_error}" ]] || refresh_error="Overlay konnte nicht erzeugt oder geprüft werden."
        printf '%s\n' "${refresh_error}" >&2
        deactivate_system_integration
        record_refresh_failure "${refresh_error}"
        die "GDM-Anpassung ist inkompatibel und wurde deaktiviert."
    fi

    print_step "Overlay atomar aktivieren"
    if ! (activate_overlay_release "${prepared_overlay}"); then
        refresh_error="Overlay konnte nicht atomar aktiviert werden."
        deactivate_system_integration
        record_refresh_failure "${refresh_error}"
        die "${refresh_error}"
    fi

    clear_refresh_failure
}

notify_refresh_failure() {
    [[ -f "${failure_state}" ]] || return 0
    [[ -f "${target_user_state}" ]] || return 0
    [[ "$(id -un)" == "$(head -n 1 "${target_user_state}")" ]] || return 0

    local values=()
    mapfile -t values < <(
        python3 - "${failure_state}" <<'PY'
import json
import pathlib
import sys

state = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(state["id"])
print(state["summary"])
print(state["body"])
PY
    )

    local identity="${values[0]}"
    local summary="${values[1]}"
    local body="${values[2]}"
    local state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
    local notified_dir="${state_home}/gdm-greeter-minimalism"
    local notified_state="${notified_dir}/notified"

    if [[ -f "${notified_state}" ]] && [[ "$(head -n 1 "${notified_state}")" == "${identity}" ]]; then
        return 0
    fi

    gdbus call \
        --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "GDM Greeter Minimalism" \
        0 \
        "" \
        "${summary}" \
        "${body}" \
        "[]" \
        "{}" \
        0 >/dev/null

    install -d -m700 "${notified_dir}"
    printf '%s\n' "${identity}" >"${notified_state}"
    chmod 600 "${notified_state}"
}

apply_override() {
    write_runtime_state
    restore_legacy_override_if_needed
    print_step "Greeter-Konfiguration schreiben"
    write_greeter_background
    write_greeter_accent
    write_greeter_input_sources
    print_step "gdm-dconf setzen"
    apply_gdm_background
    apply_gdm_accent
    apply_gdm_input_sources
    print_step "Shortcut aktualisieren"
    apply_user_shortcut
    refresh_override
    print_step "Installation prüfen"
    verify_overlay
}

verify_overlay() {
    resolve_input_sources
    verify_overlay_resources
    if legacy_override_active; then
        die "Legacy-CSS-Override noch aktiv."
    fi

    resolve_target_user
    if [[ -n "${resolved_target_user}" ]]; then
        local screensaver_binding
        local disable_lock_screen
        local shortcut
        local shortcut_path
        local shortcut_command

        screensaver_binding="$(user_gsettings_get "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys screensaver)"
        [[ "${screensaver_binding}" == "@as []" ]] || die "Screensaver-Keybind ist nicht deaktiviert: ${screensaver_binding}"
        disable_lock_screen="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.lockdown disable-lock-screen)"
        [[ "${disable_lock_screen}" == "true" ]] || die "GNOME-Lockscreen ist nicht deaktiviert: ${disable_lock_screen}"

        shortcut="$(find_super_l_shortcut "${resolved_target_user}" || true)"
        [[ -n "${shortcut}" ]] || die "Kein Super+L-Shortcut aktiv."
        shortcut_path="${shortcut%%$'\t'*}"
        shortcut_command="${shortcut#*$'\t'}"
        [[ "${shortcut_command}" == "${greeter_command_setting}" ]] || die "Super+L zeigt nicht auf den Greeter: ${shortcut_path} -> ${shortcut_command}"
    fi

    print_installed_summary
}

restore_override() {
    print_step "Systemintegration entfernen"
    deactivate_system_integration
    print_step "Greeter-Konfiguration entfernen"
    remove_greeter_background
    remove_greeter_accent
    remove_greeter_input_sources
    print_step "gdm-dconf wiederherstellen"
    restore_gdm_background
    restore_gdm_accent
    restore_gdm_input_sources
    print_step "Shortcut und Session wiederherstellen"
    restore_user_shortcut
    restore_legacy_override_if_needed
    rm -f "${active_overlay_state}" "${stock_overlay_state}" "${enabled_state}" "${target_user_state}" "${failure_state}"

    if [[ -f "${user_shell_dropin_file}" ]] || [[ -f "${gdm_service_dropin_file}" ]] || [[ -f "$(gdm_dropin_file)" ]]; then
        die "Hard-Override konnte nicht deaktiviert werden."
    fi
    if legacy_override_active; then
        die "Legacy-CSS-Override ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_input_state}" ]]; then
        die "GDM-Input-State ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_background_state}" ]]; then
        die "GDM-Background-State ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_accent_state}" ]]; then
        die "GDM-Accent-State ist weiterhin aktiv."
    fi
    if [[ -f "${user_shortcut_state}" ]]; then
        die "Shortcut-State ist weiterhin aktiv."
    fi
    if [[ -f "${greeter_desktop_state}" ]]; then
        die "Greeter-Desktop-State ist weiterhin aktiv."
    fi
    if grep -F "G_RESOURCE_OVERLAYS=" "${greeter_desktop_file}" >/dev/null; then
        die "Greeter-Desktop lädt weiterhin G_RESOURCE_OVERLAYS."
    fi
    if grep -F "${greeter_background_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Background-Override ist weiterhin aktiv."
    fi
    if grep -F "${greeter_accent_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Accent-Override ist weiterhin aktiv."
    fi
    if grep -F "${greeter_input_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Input-Override ist weiterhin aktiv."
    fi

    print_restored_summary
}

maybe_restart() {
    local restart_flag="$1"

    if [[ "${restart_flag}" == "1" ]]; then
        print_step "gdm neu starten"
        systemctl restart gdm
    fi
}

main() {
    local command="${1:-}"
    local restart_flag="0"

    setup_colors

    if [[ -z "${command}" ]]; then
        command="$(prompt_action)"
        [[ "${command}" != "exit" ]] || exit 0
        restart_flag="$(prompt_restart "${command}")"
    elif [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        usage
        exit 0
    else
        shift || true
        if [[ "${1:-}" == "--restart" ]]; then
            restart_flag="1"
            shift
        fi
    fi

    [[ "$#" -eq 0 ]] || {
        usage
        exit 1
    }

    case "${command}" in
        apply)
            ensure_root_for_action "${command}" "${restart_flag}"
            require_tools
            acquire_lock
            apply_override
            maybe_restart "${restart_flag}"
            ;;
        verify)
            require_tools
            verify_overlay
            ;;
        refresh)
            [[ "$(id -u)" -eq 0 ]] || die "refresh benötigt Root-Rechte."
            if [[ ! -f "${enabled_state}" ]] && [[ ! -f "${user_shortcut_state}" ]]; then
                exit 0
            fi
            require_tools
            acquire_lock
            restore_legacy_override_if_needed
            refresh_override
            ;;
        notify)
            notify_refresh_failure
            ;;
        restore)
            ensure_root_for_action "${command}" "${restart_flag}"
            require_tools
            acquire_lock
            restore_override
            maybe_restart "${restart_flag}"
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
