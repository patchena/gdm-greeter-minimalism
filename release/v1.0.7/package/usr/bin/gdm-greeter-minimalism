unlock_dialog = """import Clutter from 'gi://Clutter';
import GObject from 'gi://GObject';
import Shell from 'gi://Shell';
import St from 'gi://St';

import * as Main from './main.js';

export const UnlockDialog = GObject.registerClass({
    Signals: {
        'failed': {},
        'wake-up-screen': {},
    },
}, class UnlockDialog extends St.Widget {
    _init(parentActor) {
        super._init({
            visible: false,
            reactive: true,
            can_focus: true,
            style: 'background-color: #000;',
            constraints: new Clutter.BindConstraint({
                source: parentActor,
                coordinate: Clutter.BindCoordinate.ALL,
            }),
        });
        this.allowCancel = false;
        this._grab = null;
        parentActor.add_child(this);
        this.connect('destroy', () => this.popModal());
        this.connect('captured-event', () => {
            this.emit('wake-up-screen');
            return Clutter.EVENT_STOP;
        });
    }

    open() {
        this.show();
        if (!this._grab) {
            this._grab = Main.pushModal(Main.uiGroup,
                {actionMode: Shell.ActionMode.UNLOCK_SCREEN});
            if (!this._grab)
                throw new Error('Could not acquire the shield grab');
        }
        this.grab_key_focus();
        return true;
    }

    activate() {
        this.show();
        this.grab_key_focus();
        this.emit('wake-up-screen');
    }

    cancel() {
        this.grab_key_focus();
    }

    finish(onComplete) {
        this.remove_all_transitions();
        onComplete();
    }

    popModal() {
        if (this._grab) {
            Main.popModal(this._grab);
            this._grab = null;
        }
    }
});
"""

