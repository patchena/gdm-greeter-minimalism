    printf '%s/theme/source.env\n' "${overlay_root}"
}

overlay_theme_origin() {
    local source_file
    source_file="$(overlay_theme_source_file)"
    [[ -f "${source_file}" ]] || return 1
    sed -n 's/^origin=//p' "${source_file}" | head -n 1
}

resolve_target_user() {
    if [[ -n "${resolved_target_user}" ]]; then
        return 0
    fi

    local target_user="${SUDO_USER:-}"

    if [[ -z "${target_user}" ]] && [[ -n "${PKEXEC_UID:-}" ]]; then
        target_user="$(getent passwd "${PKEXEC_UID}" | awk -F: '{print $1}')"
    fi

    if [[ -z "${target_user}" ]] && [[ -n "${LOGNAME:-}" ]] && [[ "${LOGNAME}" != "root" ]] && id -u "${LOGNAME}" >/dev/null 2>&1; then
        target_user="${LOGNAME}"
    fi

    if [[ -n "${target_user}" ]] && id -u "${target_user}" >/dev/null 2>&1; then
        resolved_target_user="${target_user}"
    fi
}

resolve_managed_user() {
    if [[ -f "${target_user_state}" ]]; then
        resolved_target_user="$(head -n 1 "${target_user_state}")"
    elif [[ -f "${user_shortcut_state}" ]]; then
        resolved_target_user="$(
            python3 - "${user_shortcut_state}" <<'PY'
import json
import pathlib
import sys

state = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(state.get("user", ""))
PY
        )"
    else
        resolve_target_user
    fi

    if [[ -n "${resolved_target_user}" ]] && ! id -u "${resolved_target_user}" >/dev/null 2>&1; then
        die "Verwalteter Benutzer existiert nicht: ${resolved_target_user}"
    fi
}

write_runtime_state() {
    resolve_managed_user
    [[ -n "${resolved_target_user}" ]] || die "Kein verwalteter Benutzer ermittelt."

    install -d -m755 "${runtime_root}" "${candidate_root}" "${overlay_base}" "${overlay_releases}" "${stock_releases}" || die "Runtime-Verzeichnisse konnten nicht vorbereitet werden."
    printf '%s\n' "${resolved_target_user}" >"${target_user_state}" || die "Zielbenutzer konnte nicht gespeichert werden."
    printf '%s\n' "enabled" >"${enabled_state}" || die "Aktivierungsstatus konnte nicht gespeichert werden."
    chmod 644 "${target_user_state}" "${enabled_state}" || die "Runtime-Statusrechte konnten nicht gesetzt werden."
}

overlay_fingerprint() {
    local active_theme
    local target_home=""
    active_theme="$(active_theme_path)"
    resolve_managed_user
    if [[ -n "${resolved_target_user}" ]]; then
        target_home="$(getent passwd "${resolved_target_user}" | awk -F: '{print $6}')"
    fi

    python3 - "${shell_resource}" "${active_theme}" "${target_home}" "${overlay_revision}" "${BASH_SOURCE[0]}" <<'PY'
import hashlib
import pathlib
import shlex
import sys

shell_resource = pathlib.Path(sys.argv[1])
theme_resource = pathlib.Path(sys.argv[2])
target_home = pathlib.Path(sys.argv[3]) if sys.argv[3] else None
revision = sys.argv[4]
script_path = pathlib.Path(sys.argv[5])
digest = hashlib.sha256()

for value in (revision.encode(), script_path.read_bytes(), shell_resource.read_bytes(), theme_resource.read_bytes()):
    digest.update(len(value).to_bytes(8, "big"))
    digest.update(value)

if target_home is not None:
    state_path = target_home / ".local" / "state" / "custom-yaru-theme" / "last-state.env"
    if state_path.is_file():
        state_content = state_path.read_bytes()
        digest.update(len(state_content).to_bytes(8, "big"))
        digest.update(state_content)
        state = {}
        for line in state_content.decode().splitlines():
            parts = shlex.split(line.strip())
            if len(parts) == 1 and "=" in parts[0]:
                key, value = parts[0].split("=", 1)
                state[key] = value
        css_path = pathlib.Path(state.get("dark_css_target", ""))
        if css_path.is_file():
            css_content = css_path.read_bytes()
            digest.update(len(css_content).to_bytes(8, "big"))
            digest.update(css_content)

print(digest.hexdigest()[:24])
PY
}

stock_fingerprint() {
    local active_theme
    active_theme="$(active_theme_path)"

    python3 - "${shell_resource}" "${active_theme}" "${overlay_revision}" <<'PY'
import hashlib
import pathlib
import sys

digest = hashlib.sha256()
for content in (sys.argv[3].encode(), *(path.read_bytes() for path in map(pathlib.Path, sys.argv[1:3]))):
    digest.update(len(content).to_bytes(8, "big"))
    digest.update(content)
print(digest.hexdigest()[:24])
PY
}

run_in_user_session() {
    local target_user="$1"
    shift

    if [[ "$(id -u)" -eq 0 ]]; then
        local target_uid
        local runtime_dir
        target_uid="$(id -u "${target_user}")"
        runtime_dir="/run/user/${target_uid}"
        [[ -S "${runtime_dir}/bus" ]] || die "Session-Bus fuer ${target_user} fehlt: ${runtime_dir}/bus"
        runuser -u "${target_user}" -- env XDG_RUNTIME_DIR="${runtime_dir}" DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime_dir}/bus" "$@"
    else
        [[ "$(id -un)" == "${target_user}" ]] || die "Benutzerkontext ${target_user} ist ohne root nicht verfuegbar."
        "$@"
    fi
}

user_gsettings_get() {
    local target_user="$1"
    local schema="$2"
    local key="$3"

    run_in_user_session "${target_user}" gsettings get "${schema}" "${key}"
}

user_gsettings_set() {
    local target_user="$1"
    local schema="$2"
    local key="$3"
    local value="$4"

    run_in_user_session "${target_user}" gsettings set "${schema}" "${key}" "${value}"
}

user_gsettings_reset() {
    local target_user="$1"
    local schema="$2"
    local key="$3"

    run_in_user_session "${target_user}" gsettings reset "${schema}" "${key}"
}

run_gdm_dconf_write() {
    local key="$1"
    local output
    shift

    if ! output="$(runuser -u gdm -- dbus-run-session dconf write "${key}" "$@" 2>&1)"; then
        [[ -n "${output}" ]] && printf '%s\n' "${output}" >&2
        die "dconf write fehlgeschlagen: ${key}"
    fi
}

gdm_gsettings_get() {
    local schema="$1"
    local key="$2"
    local profile="${gdm_profile}"
    local output

    if [[ -f "${gdm_named_profile}" ]]; then
        profile="gdm"
    fi
    if ! output="$(env HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent DCONF_PROFILE="${profile}" gsettings get "${schema}" "${key}" 2>&1)"; then
        [[ -n "${output}" ]] && printf '%s\n' "${output}" >&2
        die "GDM-GSettings-Abfrage fehlgeschlagen: ${schema} ${key}"
    fi
    printf '%s\n' "${output}"
}

packaged_gdm_gsettings_get() {
    local schema="$1"
    local key="$2"
    local output

    if ! output="$(env HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent DCONF_PROFILE="${gdm_profile}" gsettings get "${schema}" "${key}" 2>&1)"; then
        [[ -n "${output}" ]] && printf '%s\n' "${output}" >&2
        die "Paketiertes GDM-GSettings-Abfrage fehlgeschlagen: ${schema} ${key}"
    fi
    printf '%s\n' "${output}"
}

gdm_gsettings_writable() {
    local schema="$1"
    local key="$2"
    local profile="${gdm_profile}"
    local output

    if [[ -f "${gdm_named_profile}" ]]; then
        profile="gdm"
    fi
    if ! output="$(env HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent DCONF_PROFILE="${profile}" gsettings writable "${schema}" "${key}" 2>&1)"; then
        [[ -n "${output}" ]] && printf '%s\n' "${output}" >&2
        die "GDM-GSettings-Schreibschutzabfrage fehlgeschlagen: ${schema} ${key}"
    fi
    printf '%s\n' "${output}"
}

compile_greeter_dconf() {
    "${gdm_generate_config}"
}

write_gdm_profile() {
    [[ -f "${gdm_named_profile}" ]] || return 0

    if [[ ! -f "${gdm_profile_state}" ]]; then
        install -m600 "${gdm_named_profile}" "${gdm_profile_state}"
    fi

    python3 - "${gdm_named_profile}" <<'PY'
import os
import pathlib
import sys

target = pathlib.Path(sys.argv[1])
legacy = "file-db:/usr/share/gdm/greeter-dconf-defaults"
current = "file-db:/var/lib/gdm3/greeter-dconf-defaults"
lines = target.read_text(encoding="utf-8").splitlines()

if current not in lines:
    if lines.count(legacy) != 1:
        raise SystemExit(f"GDM-dconf-Profil enthält kein eindeutiges Legacy-Ziel: {target}")
    lines[lines.index(legacy)] = current

metadata = target.stat()
pending = target.with_name(f".{target.name}.ggm-{os.getpid()}")
pending.write_text("\n".join(lines) + "\n", encoding="utf-8")
pending.chmod(metadata.st_mode & 0o777)
os.chown(pending, metadata.st_uid, metadata.st_gid)
os.replace(pending, target)
PY
}

restore_gdm_profile() {
    [[ -f "${gdm_profile_state}" ]] || return 0

    install -m644 "${gdm_profile_state}" "${gdm_named_profile}"
    rm -f "${gdm_profile_state}"
}

run_gjs_check() {
    local env_value="$1"
    local script="$2"
    local output

    if ! output="$(G_RESOURCE_OVERLAYS="${env_value}" gjs -c "${script}" 2>&1)"; then
        [[ -n "${output}" ]] && printf '%s\n' "${output}" >&2
        die "GResource-Check fehlgeschlagen."
    fi
}

resolve_input_sources() {
    resolve_target_user

    if [[ -n "${resolved_target_user}" ]]; then
        resolved_sources="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.input-sources sources)"
        resolved_mru_sources="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.input-sources mru-sources)"
        resolved_xkb_options="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.input-sources xkb-options)"
        resolved_input_origin="Aufrufender Benutzer ${resolved_target_user}"
    else
        local x11_layout
        x11_layout="$(localectl status | awk -F': ' '/X11 Layout/ {print $2}')"
        if [[ -z "${x11_layout}" ]] || [[ "${x11_layout}" == "(unset)" ]]; then
            die "Kein X11-Layout gefunden."
        fi
        resolved_sources="[('xkb', '${x11_layout}')]"
        resolved_mru_sources="${resolved_sources}"
        resolved_xkb_options="@as []"
        resolved_input_origin="Systemlayout ${x11_layout}"
    fi

    [[ -n "${resolved_sources}" ]] || die "Keine Greeter-Input-Sources ermittelt."
    [[ -n "${resolved_mru_sources}" ]] || die "Keine Greeter-MRU-Sources ermittelt."
    [[ -n "${resolved_xkb_options}" ]] || die "Keine Greeter-XKB-Optionen ermittelt."

    if [[ "${resolved_mru_sources}" == "@a(ss) []" ]]; then
        resolved_mru_sources="${resolved_sources}"
    fi
}

backup_user_shortcut() {
    local shortcut_path="$1"
    resolve_target_user
    [[ -n "${resolved_target_user}" ]] || die "Kein aufrufender Benutzer fuer Super+L ermittelt."

    if [[ -f "${user_shortcut_state}" ]]; then
        if ! python3 - "${user_shortcut_state}" "${resolved_target_user}" <<'PY' >/dev/null
import json
import pathlib
import sys

state_path = pathlib.Path(sys.argv[1])
expected_user = sys.argv[2]
state = json.loads(state_path.read_text(encoding="utf-8"))
raise SystemExit(0 if state.get("user") == expected_user else 1)
PY
        then
            die "Shortcut-State gehoert zu einem anderen Benutzer."
        fi
        return 0
    fi

    local screensaver disable_lock_screen custom_keybindings name command binding
    local schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}"
    screensaver="$(user_gsettings_get "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys screensaver)" || die "Screensaver-Belegung konnte nicht gesichert werden."
    disable_lock_screen="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.lockdown disable-lock-screen)" || die "Lockdown-Einstellung konnte nicht gesichert werden."
    custom_keybindings="$(user_gsettings_get "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys custom-keybindings)" || die "Shortcut-Liste konnte nicht gesichert werden."
    name="$(user_gsettings_get "${resolved_target_user}" "${schema}" name)" || die "Shortcut-Name konnte nicht gesichert werden."
    command="$(user_gsettings_get "${resolved_target_user}" "${schema}" command)" || die "Shortcut-Befehl konnte nicht gesichert werden."
    binding="$(user_gsettings_get "${resolved_target_user}" "${schema}" binding)" || die "Shortcut-Belegung konnte nicht gesichert werden."

    python3 - "${user_shortcut_state}" "${resolved_target_user}" "${shortcut_path}" \
        "${screensaver}" "${disable_lock_screen}" "${custom_keybindings}" \
        "${name}" "${command}" "${binding}" <<'PY'
import json
import pathlib
import sys

state = {
    "user": sys.argv[2],
    "path": sys.argv[3],
    "screensaver": sys.argv[4],
    "disable_lock_screen": sys.argv[5],
    "custom_keybindings": sys.argv[6],
    "name": sys.argv[7],
    "command": sys.argv[8],
    "binding": sys.argv[9],
}
pathlib.Path(sys.argv[1]).write_text(json.dumps(state), encoding="utf-8")
PY
}

gvariant_json() {
    gjs -c 'const GLib = imports.gi.GLib; const value = GLib.Variant.parse(new GLib.VariantType(ARGV[0]), ARGV[1], null, null); print(JSON.stringify(value.deep_unpack()));' "$1" "$2" || die "Ungültiger GSettings-Wert."
}

list_custom_keybinding_paths() {
    local custom_keybindings
    custom_keybindings="$(gvariant_json as "$1")" || die "Ungültige Shortcut-Liste."

    python3 - "${custom_keybindings}" <<'PY'
import json
import sys

for path in json.loads(sys.argv[1]):
    print(path)
PY
}

binding_contains_super_l() {
    local binding
    local matches
    binding="$(gvariant_json s "$1")" || return 2
    matches="$(gjs -c 'imports.gi.versions.Gtk = "4.0"; const Gtk = imports.gi.Gtk; const value = JSON.parse(ARGV[0]); const [valid, key, modifiers] = Gtk.accelerator_parse(value); const [, expectedKey, expectedModifiers] = Gtk.accelerator_parse("<Super>l"); if (!valid && value !== "") throw new Error("Ungültige Shortcut-Belegung"); print(valid && key === expectedKey && modifiers === expectedModifiers);' "${binding}")" || return 2
    [[ "${matches}" == true ]]
}

find_super_l_shortcut() {
    local target_user="$1"
    local custom_keybindings
    local current_path
    local binding
    local command
    local paths
    local match=""

    custom_keybindings="$(user_gsettings_get "${target_user}" org.gnome.settings-daemon.plugins.media-keys custom-keybindings)"
    paths="$(list_custom_keybinding_paths "${custom_keybindings}")" || return 2

    while IFS= read -r current_path; do
        [[ -n "${current_path}" ]] || continue
        binding="$(user_gsettings_get "${target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${current_path}" binding)" || return 2
        if binding_contains_super_l "${binding}"; then
            command="$(user_gsettings_get "${target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${current_path}" command)" || return 2
            if [[ -n "${match}" ]]; then
                printf 'Super+L ist mehrfach belegt: %s und %s\n' "${match%%$'\t'*}" "${current_path}" >&2
                return 2
            fi
            match="${current_path}"$'\t'"${command}"
        else
            [[ "$?" -eq 1 ]] || return 2
        fi
    done <<<"${paths}"

    [[ -n "${match}" ]] || return 1
    printf '%s\n' "${match}"
}

apply_user_shortcut() {
    resolve_managed_user
    [[ -n "${resolved_target_user}" ]] || die "Kein verwalteter Benutzer für Super+L ermittelt."

    local custom_keybindings
    local merged_custom_keybindings
    local existing_super_l
    local existing_path=""
    local existing_command=""

    custom_keybindings="$(user_gsettings_get "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys custom-keybindings)"
    if existing_super_l="$(find_super_l_shortcut "${resolved_target_user}")"; then
        existing_path="${existing_super_l%%$'\t'*}"
        existing_command="${existing_super_l#*$'\t'}"
    else
        [[ "$?" -eq 1 ]] || die "Super+L-Belegung konnte nicht gelesen werden."
    fi

    if [[ -n "${existing_path}" ]] && [[ "${existing_command}" != "${greeter_command_setting}" ]] && [[ "${existing_command}" != "${previous_greeter_command_setting}" ]]; then
        die "Super+L ist bereits belegt: ${existing_path} -> ${existing_command}"
    fi

    local shortcut_path="${existing_path:-${user_shortcut_path}}"
    backup_user_shortcut "${shortcut_path}"
    custom_keybindings="$(gvariant_json as "${custom_keybindings}")" || die "Ungültige Shortcut-Liste."
    merged_custom_keybindings="$(python3 - "${custom_keybindings}" "${user_shortcut_path}" "${existing_path}" <<'PY'
import json
import sys

current = json.loads(sys.argv[1])
managed = sys.argv[2]
existing = sys.argv[3]
if not existing and managed not in current:
    current.append(managed)
print(repr(current))
PY
)"

    user_gsettings_set "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys screensaver "@as []"
    user_gsettings_set "${resolved_target_user}" org.gnome.desktop.lockdown disable-lock-screen "false"

    if [[ -z "${existing_path}" ]] || [[ "${existing_path}" == "${user_shortcut_path}" ]]; then
        user_gsettings_set "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys custom-keybindings "${merged_custom_keybindings}"
    fi

    user_gsettings_set "${resolved_target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" name "'Lock To Login Screen'"
    user_gsettings_set "${resolved_target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" command "${greeter_command_setting}"
    user_gsettings_set "${resolved_target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" binding "'<Super>l'"
}

restore_user_shortcut() {
    local state_lines=()

    mapfile -t state_lines < <(python3 - "${user_shortcut_state}" <<'PY'
import json
import pathlib
import sys

state_path = pathlib.Path(sys.argv[1])
if state_path.exists():
    state = json.loads(state_path.read_text(encoding="utf-8"))
else:
    state = {
        "user": None,
        "path": "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gdm-greeter-minimalism/",
        "screensaver": "@as []",
        "disable_lock_screen": "false",
        "custom_keybindings": "[]",
        "name": "''",
        "command": "''",
        "binding": "@as []",
    }

print(state["user"] or "")
print(state["path"])
print(state["screensaver"])
print(state.get("disable_lock_screen", "false"))
print(state["custom_keybindings"])
print(state["name"])
print(state["command"])
print(state["binding"])
PY
)

    local target_user="${state_lines[0]}"
    local shortcut_path="${state_lines[1]}"
    local screensaver="${state_lines[2]}"
    local disable_lock_screen="${state_lines[3]}"
    local custom_keybindings="${state_lines[4]}"
    local shortcut_name="${state_lines[5]}"
    local shortcut_command="${state_lines[6]}"
    local shortcut_binding="${state_lines[7]}"

    if [[ -n "${target_user}" ]]; then
        user_gsettings_set "${target_user}" org.gnome.settings-daemon.plugins.media-keys screensaver "${screensaver}"
        user_gsettings_set "${target_user}" org.gnome.desktop.lockdown disable-lock-screen "${disable_lock_screen}"
        user_gsettings_set "${target_user}" org.gnome.settings-daemon.plugins.media-keys custom-keybindings "${custom_keybindings}"
        user_gsettings_set "${target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" name "${shortcut_name}"
        user_gsettings_set "${target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" command "${shortcut_command}"
        user_gsettings_set "${target_user}" "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${shortcut_path}" binding "${shortcut_binding}"
    fi

    rm -f "${user_shortcut_state}"
}

write_greeter_input_sources() {
    resolve_input_sources

    python3 - "${greeter_dconf_file}" "${greeter_input_begin}" "${greeter_input_end}" "${resolved_sources}" "${resolved_mru_sources}" "${resolved_xkb_options}" <<'PY'
import pathlib
import re
import sys

target = pathlib.Path(sys.argv[1])
begin = sys.argv[2]
end = sys.argv[3]
sources = sys.argv[4]
mru_sources = sys.argv[5]
xkb_options = sys.argv[6]

content = target.read_text(encoding="utf-8")
pattern = re.compile(rf"\n?{re.escape(begin)}\n.*?{re.escape(end)}\n?", re.S)
content = re.sub(pattern, "\n", content).rstrip()
block = (
    f"{begin}\n"
    "[org/gnome/desktop/input-sources]\n"
    f"sources={sources}\n"
    f"mru-sources={mru_sources}\n"
    f"xkb-options={xkb_options}\n"
    f"{end}\n"
)
target.write_text(f"{content}\n\n{block}", encoding="utf-8")
PY

    "${gdm_generate_config}"
}

