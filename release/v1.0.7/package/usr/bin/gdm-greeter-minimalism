manage_dropin_file() {
    local operation="$1"
    local file="$2"
    local owner="$3"

    python3 - "${operation}" "${file}" "${owner}" "$(overlay_env)" <<'PY'
import os
import pathlib
import pwd
import secrets
import sys

operation = sys.argv[1]
target = pathlib.Path(sys.argv[2])
owner = pwd.getpwnam(sys.argv[3])
content = f"[Service]\nEnvironment=G_RESOURCE_OVERLAYS={sys.argv[4]}\n".encode()
if not target.is_absolute() or ".." in target.parts:
    raise SystemExit(f"Ungültiger Drop-in-Pfad: {target}")
directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
pending = None
try:
    for component in target.parts[1:-1]:
        try:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
        except FileNotFoundError:
            if operation == "remove":
                raise SystemExit(0)
            os.mkdir(component, 0o755, dir_fd=directory)
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
        os.close(directory)
        directory = child
    if operation == "remove":
        try:
            os.unlink(target.name, dir_fd=directory)
        except FileNotFoundError:
            pass
    elif operation == "write":
        next_pending = f".{target.name}.ggm-{secrets.token_hex(16)}"
        descriptor = os.open(next_pending, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        pending = next_pending
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fchown(stream.fileno(), owner.pw_uid, owner.pw_gid)
        os.replace(pending, target.name, src_dir_fd=directory, dst_dir_fd=directory)
        pending = None
    else:
        raise SystemExit(f"Ungültige Drop-in-Operation: {operation}")
finally:
    if pending is not None:
        os.unlink(pending, dir_fd=directory)
    os.close(directory)
PY
}

write_dropin_file() {
    manage_dropin_file write "$1" "${2:-root}"
}

remove_dropin_file() {
    manage_dropin_file remove "$1" root
}

reload_managed_user_manager() {
    local target_uid
    local runtime_dir
    target_uid="$(id -u "${resolved_target_user}")"
    runtime_dir="/run/user/${target_uid}"

    if [[ -S "${runtime_dir}/bus" ]]; then
        run_in_user_session "${resolved_target_user}" systemctl --user daemon-reload
    fi
}

write_dropins() {
    write_dropin_file "${user_shell_dropin_file}" || die "User-Drop-in konnte nicht geschrieben werden."
    write_dropin_file "${gdm_service_dropin_file}" || die "GDM-Drop-in konnte nicht geschrieben werden."
    write_dropin_file "$(gdm_dropin_file)" gdm || die "GDM-User-Drop-in konnte nicht geschrieben werden."
    remove_dropin_file "${previous_global_wayland_dropin_file}" || die "Alter User-Drop-in konnte nicht entfernt werden."
    remove_dropin_file "$(previous_gdm_wayland_dropin_file)" || die "Alter GDM-Drop-in konnte nicht entfernt werden."
    systemctl daemon-reload || die "Systemmanager konnte nicht neu geladen werden."
    reload_managed_user_manager || die "Benutzermanager konnte nicht neu geladen werden."
}

verify_overlay_resources() {
    local env_value
    local mode="${1:-installed}"
    local target_root="${2:-${overlay_root}}"
    local overlay_root="${target_root}"
    env_value="$(overlay_env)"

    if [[ "${mode}" == "installed" ]]; then
        [[ -f "${user_shell_dropin_file}" ]] || die "User-Shell-Drop-in fehlt: ${user_shell_dropin_file}"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "${user_shell_dropin_file}" >/dev/null || die "User-Shell-Drop-in enthält kein G_RESOURCE_OVERLAYS."
        [[ -f "${gdm_service_dropin_file}" ]] || die "GDM-Service-Drop-in fehlt: ${gdm_service_dropin_file}"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "${gdm_service_dropin_file}" >/dev/null || die "GDM-Service-Drop-in enthält kein G_RESOURCE_OVERLAYS."
        [[ -f "$(gdm_dropin_file)" ]] || die "GDM-Drop-in fehlt: $(gdm_dropin_file)"
        grep -F "Environment=G_RESOURCE_OVERLAYS=${env_value}" "$(gdm_dropin_file)" >/dev/null || die "GDM-Drop-in enthält kein G_RESOURCE_OVERLAYS."
    fi
    [[ -f "$(overlay_session_file)" ]] || die "Overlay-Datei fehlt: $(overlay_session_file)"
    [[ -f "$(overlay_panel_file)" ]] || die "Overlay-Datei fehlt: $(overlay_panel_file)"
    [[ -f "$(overlay_system_actions_file)" ]] || die "Overlay-Datei fehlt: $(overlay_system_actions_file)"
    [[ -f "$(overlay_screen_shield_file)" ]] || die "Overlay-Datei fehlt: $(overlay_screen_shield_file)"
    [[ -f "$(overlay_shell_dbus_file)" ]] || die "Overlay-Datei fehlt: $(overlay_shell_dbus_file)"
    [[ -f "$(overlay_unlock_file)" ]] || die "Overlay-Datei fehlt: $(overlay_unlock_file)"
    [[ -f "$(overlay_auth_prompt_file)" ]] || die "Overlay-Datei fehlt: $(overlay_auth_prompt_file)"
    [[ -f "$(overlay_login_file)" ]] || die "Overlay-Datei fehlt: $(overlay_login_file)"
    [[ -f "$(overlay_theme_file)" ]] || die "Overlay-Datei fehlt: $(overlay_theme_file)"
    [[ -f "$(overlay_theme_source_file)" ]] || die "Overlay-Theme-Quelle fehlt: $(overlay_theme_source_file)"
    if [[ "${mode}" == "installed" ]]; then
        grep -F "Exec=env G_RESOURCE_OVERLAYS=${env_value} gnome-session" "${greeter_desktop_file}" >/dev/null || die "Greeter-Desktop lädt kein G_RESOURCE_OVERLAYS."
    fi

    grep -F "'unlock-dialog': {" "$(overlay_session_file)" >/dev/null || die "unlock-dialog-Override fehlt."
    grep -F "'gdm': {" "$(overlay_session_file)" >/dev/null || die "gdm-Override fehlt."
    grep -F "Main.sessionMode.isLocked" "$(overlay_panel_file)" >/dev/null || die "panel-Override für unlock-dialog fehlt."
    grep -F "this._actions.get(LOCK_SCREEN_ACTION_ID).available = showLock;" "$(overlay_system_actions_file)" >/dev/null || die "systemActions-Lock-Button-Override fehlt."
    grep -F "Main.screenShield.switchToGreeter(false);" "$(overlay_system_actions_file)" >/dev/null || die "systemActions-Greeter-Action-Override fehlt."
    grep -F "switchToGreeter(animate = true)" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Methode fehlt."
    grep -F "this._lockSession(false);" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Sessionsperre ohne Animation fehlt."
    grep -F "this._completeLockScreenShown({...params, animateFade: false});" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Paint vor Inhibitorfreigabe fehlt."
    grep -F "return this.switchToGreeter(animate);" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Lock-Weiterleitung fehlt."
    grep -F "import Gdm from 'gi://Gdm';" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-GDM-Import fehlt."
    grep -F "if (!Gdm.goto_login_session_sync(null))" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Wechsel fehlt."
    grep -F "return this._greeterSwitchPromise;" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Greeter-Promise fehlt."
    grep -F "await this._screenShield.lock(true);" "$(overlay_shell_dbus_file)" >/dev/null || die "ScreenSaver-D-Bus-Lock-Promise fehlt."
    grep -F "invocation.return_dbus_error('org.gnome.ScreenSaver.Error.Failed', error.message);" "$(overlay_shell_dbus_file)" >/dev/null || die "ScreenSaver-D-Bus-Fehlerantwort fehlt."
    grep -F "St.Clipboard.get_default().set_text(St.ClipboardType.CLIPBOARD, '')" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Clipboard-Override fehlt."
    grep -F "St.Clipboard.get_default().set_text(St.ClipboardType.PRIMARY, '')" "$(overlay_screen_shield_file)" >/dev/null || die "screenShield-Primary-Clipboard-Override fehlt."
    grep -F "CreateTransientDisplay" "$(overlay_screen_shield_file)" >/dev/null && die "screenShield erzeugt weiterhin transiente Displays."
    grep -F "coordinate: Clutter.BindCoordinate.ALL," "$(overlay_unlock_file)" >/dev/null || die "unlockDialog-Schutzfläche über alle Monitore fehlt."
    grep -F "style: 'background-color: #000;'," "$(overlay_unlock_file)" >/dev/null || die "unlockDialog-Schutzfläche ist nicht opak."
    grep -E 'AuthPrompt|Gdm|Background|Clock|Notifications|SwipeTracker' "$(overlay_unlock_file)" >/dev/null && die "unlockDialog enthält weiterhin Stock-Ressourcen."
    grep -F "this._userWell.set_child(null);" "$(overlay_auth_prompt_file)" >/dev/null || die "authPrompt-Avatar-Override fehlt."
    grep -F "this._bottomButtonGroup.hide();" "$(overlay_login_file)" >/dev/null || die "loginDialog-Override fehlt."
    grep -F "const cancelVisible = this._authPrompt._entry === this._authPrompt._passwordEntry;" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Eingabetyp-Override fehlt."
    grep -F "this._updateCancelButton();" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Zustandsaktualisierung fehlt."
    grep -F "this._authPrompt.cancelButton.opacity = cancelVisible ? 255 : 0;" "$(overlay_login_file)" >/dev/null || die "loginDialog-Cancel-Layout-Override fehlt."
    grep -F "actor === this._authPrompt" "$(overlay_login_file)" >/dev/null || die "loginDialog-Zentrierungs-Override fehlt."
    grep -F "background-color: ${greeter_background_color};" "$(overlay_theme_file)" >/dev/null || die "Theme-Override nutzt nicht die Greeter-Hintergrundfarbe."
    grep -F -- "-st-accent-color: ${greeter_focus_accent_color};" "$(overlay_theme_file)" >/dev/null || die "Theme-Override nutzt nicht die neutrale Fokusfarbe."
    grep -F "st-mix(-st-accent-color" "$(overlay_theme_file)" >/dev/null && die "Theme-Override enthält noch dynamische Fokus-Akzentfarbe."
    if [[ "${mode}" == "installed" ]]; then
        [[ -f "${gdm_input_state}" ]] || die "GDM-Input-State fehlt."
        [[ -f "${gdm_background_state}" ]] || die "GDM-Background-State fehlt."
        [[ -f "${gdm_accent_state}" ]] || die "GDM-Accent-State fehlt."
        grep -F "${greeter_background_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Background-Override fehlt."
        grep -F "background-color='${greeter_background_color}'" "${greeter_dconf_file}" >/dev/null || die "Greeter-Background nutzt nicht die Greeter-Hintergrundfarbe."
        grep -F "${greeter_accent_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Accent-Override fehlt."
        grep -F "accent-color=${greeter_accent_color}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Accent ist nicht neutral."
        grep -F "${greeter_input_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Input-Override fehlt."
        grep -F "sources=" "${greeter_dconf_file}" >/dev/null || die "Greeter-Sources fehlen."
        grep -F "${greeter_sound_begin}" "${greeter_dconf_file}" >/dev/null || die "Greeter-Sound-Override fehlt."
        grep -F "event-sounds=false" "${greeter_dconf_file}" >/dev/null || die "Greeter-Ereignisklänge sind nicht deaktiviert."
        grep -F "input-feedback-sounds=false" "${greeter_dconf_file}" >/dev/null || die "Greeter-Eingabeklänge sind nicht deaktiviert."
        grep -F "theme-name='${greeter_sound_theme}'" "${greeter_dconf_file}" >/dev/null || die "Greeter-Klangthema ist nicht gesetzt."
        grep -F "audible-bell=false" "${greeter_dconf_file}" >/dev/null || die "Greeter-System-Bell ist nicht deaktiviert."
        [[ -f "${greeter_sound_lock_file}" ]] || die "Greeter-Sound-Sperren fehlen."
        grep -Fx "/org/gnome/desktop/sound/event-sounds" "${greeter_sound_lock_file}" >/dev/null || die "Greeter-Ereignisklang-Sperre fehlt."
        grep -Fx "/org/gnome/desktop/sound/input-feedback-sounds" "${greeter_sound_lock_file}" >/dev/null || die "Greeter-Eingabeklang-Sperre fehlt."
        grep -Fx "/org/gnome/desktop/sound/theme-name" "${greeter_sound_lock_file}" >/dev/null || die "Greeter-Klangthema-Sperre fehlt."
        grep -Fx "/org/gnome/desktop/wm/preferences/audible-bell" "${greeter_sound_lock_file}" >/dev/null || die "Greeter-System-Bell-Sperre fehlt."
        if [[ -f "${gdm_named_profile}" ]]; then
            [[ -f "${gdm_profile_state}" ]] || die "GDM-Profil-Sicherung fehlt."
            grep -Fx "file-db:/var/lib/gdm3/greeter-dconf-defaults" "${gdm_named_profile}" >/dev/null || die "GDM-Profil nutzt nicht die aktuelle Greeter-Datenbank."
        fi
        [[ -f "${greeter_sound_theme_dir}/index.theme" ]] || die "Greeter-Klangthema fehlt."
        local event
        for event in "${greeter_sound_events[@]}"; do
            [[ -f "${greeter_sound_theme_dir}/stereo/${event}.disabled" ]] || die "Greeter-Klangereignis ist nicht deaktiviert: ${event}"
        done
        [[ "$(gdm_gsettings_get org.gnome.desktop.sound event-sounds)" == "false" ]] || die "Wirksame Greeter-Ereignisklänge sind nicht deaktiviert."
        [[ "$(gdm_gsettings_get org.gnome.desktop.sound input-feedback-sounds)" == "false" ]] || die "Wirksame Greeter-Eingabeklänge sind nicht deaktiviert."
        [[ "$(gdm_gsettings_get org.gnome.desktop.sound theme-name)" == "'${greeter_sound_theme}'" ]] || die "Wirksames Greeter-Klangthema ist falsch."
        [[ "$(gdm_gsettings_get org.gnome.desktop.wm.preferences audible-bell)" == "false" ]] || die "Wirksame Greeter-System-Bell ist nicht deaktiviert."
        [[ "$(gdm_gsettings_writable org.gnome.desktop.sound event-sounds)" == "false" ]] || die "Greeter-Ereignisklänge sind nicht gesperrt."
        [[ "$(gdm_gsettings_writable org.gnome.desktop.sound input-feedback-sounds)" == "false" ]] || die "Greeter-Eingabeklänge sind nicht gesperrt."
        [[ "$(gdm_gsettings_writable org.gnome.desktop.sound theme-name)" == "false" ]] || die "Greeter-Klangthema ist nicht gesperrt."
        [[ "$(gdm_gsettings_writable org.gnome.desktop.wm.preferences audible-bell)" == "false" ]] || die "Greeter-System-Bell ist nicht gesperrt."
        [[ "$(packaged_gdm_gsettings_get org.gnome.desktop.sound event-sounds)" == "false" ]] || die "Paketierte Greeter-Ereignisklänge sind nicht deaktiviert."
        [[ "$(packaged_gdm_gsettings_get org.gnome.desktop.sound input-feedback-sounds)" == "false" ]] || die "Paketierte Greeter-Eingabeklänge sind nicht deaktiviert."
        [[ "$(packaged_gdm_gsettings_get org.gnome.desktop.sound theme-name)" == "'${greeter_sound_theme}'" ]] || die "Paketiertes Greeter-Klangthema ist falsch."
        [[ "$(packaged_gdm_gsettings_get org.gnome.desktop.wm.preferences audible-bell)" == "false" ]] || die "Paketierte Greeter-System-Bell ist nicht deaktiviert."
    fi

    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/sessionMode.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes(\"'gdm': {\\n        hasNotifications: false,\") || !text.includes(\"'unlock-dialog': {\\n        hasNotifications: false,\") || !text.includes(\"'user': {\") || !text.includes(\"        hasNotifications: true,\") || !text.includes(\"panelStyle: null,\") || !text.includes(\"right: ['keyboard'],\")) throw new Error('sessionMode lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/panel.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('Main.layoutManager.panelBox.hide();') || !text.includes('Main.sessionMode.isLocked') || text.includes('const hasVisibleItems =')) throw new Error('panel lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/misc/systemActions.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._actions.get(LOCK_SCREEN_ACTION_ID).available = showLock;') || !text.includes('Main.screenShield.switchToGreeter(false);') || text.includes('showLock && allowLockScreen') || !text.includes('Main.screenShield.lock(true);')) throw new Error('systemActions lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; for (const name of ['screenShield', 'shellDBus']) { const data = Gio.resources_lookup_data('/org/gnome/shell/ui/' + name + '.js', 0); Reflect.parse(ByteArray.toString(data.toArray()), {target: 'module'}); }" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/ui/unlockDialog.js', 0); const text = ByteArray.toString(data.toArray()); Reflect.parse(text, {target: 'module'}); if (!text.includes('export const UnlockDialog = GObject.registerClass(') || !text.includes('coordinate: Clutter.BindCoordinate.ALL,') || !text.includes(\"style: 'background-color: #000;',\") || /AuthPrompt|Gdm|Background|Clock|Notifications|SwipeTracker/.test(text)) throw new Error('unlockDialog lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/gdm/authPrompt.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._userWell.set_child(null);') || !text.includes('visible: false,')) throw new Error('authPrompt lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/gdm/loginDialog.js', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('this._bottomButtonGroup.hide();') || !text.includes('this._a11yMenuButton = null;') || !text.includes('const cancelVisible = this._authPrompt._entry === this._authPrompt._passwordEntry;') || !text.includes('this._authPrompt.cancelButton.reactive = cancelVisible;') || !text.includes('this._updateCancelButton();') || !text.includes('this._authPrompt.cancelButton.opacity = cancelVisible ? 255 : 0;') || !text.includes('actor === this._authPrompt') || !text.includes('centerY - anchorHeight / 2')) throw new Error('loginDialog lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; const ByteArray = imports.byteArray; const data = Gio.resources_lookup_data('/org/gnome/shell/theme/gdm.css', 0); const text = ByteArray.toString(data.toArray()); if (!text.includes('#lockDialogGroup {') || !text.includes('background-color: ${greeter_background_color};') || !text.includes('background-color: #353535;') || !text.includes('-st-accent-color: ${greeter_focus_accent_color};') || text.includes('st-mix(-st-accent-color')) throw new Error('theme lookup fehlgeschlagen');" || die "GResource-Prüfung fehlgeschlagen."
}

record_refresh_failure() {
    local detail="$1"
    local gdm_version
    local shell_version
    gdm_version="$(dpkg-query -W -f='${Version}' gdm3 2>/dev/null || printf 'unbekannt')"
    shell_version="$(dpkg-query -W -f='${Version}' gnome-shell 2>/dev/null || printf 'unbekannt')"

    install -d -m755 "${runtime_root}"
    python3 - "${failure_state}" "${gdm_version}" "${shell_version}" "${detail}" <<'PY'
import json
import pathlib
import sys
import uuid

gdm_version = sys.argv[2]
shell_version = sys.argv[3]
detail = " ".join(sys.argv[4].split())
path = pathlib.Path(sys.argv[1])
identity = uuid.uuid4().hex
if path.is_file():
    current = json.loads(path.read_text(encoding="utf-8"))
    if (
        current.get("detail") == detail
        and current.get("gdm_version") == gdm_version
        and current.get("gnome_shell_version") == shell_version
    ):
        identity = current["id"]
state = {
    "id": identity,
    "summary": "GDM-Anpassung fehlgeschlagen",
    "body": (
        "Die GDM-Anpassung konnte nicht abgeschlossen werden. "
        "Details stehen in /var/lib/gdm-greeter-minimalism/failure.json."
    ),
    "detail": detail,
    "gdm_version": gdm_version,
    "gnome_shell_version": shell_version,
}
path.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
path.chmod(0o644)
PY
}

clear_refresh_failure() {
    rm -f "${failure_state}"
}

write_stock_overlay() {
    local target_root="$1"
    local active_theme
    active_theme="$(active_theme_path)"

    install -d -m755 "${target_root}/ui" "${target_root}/gdm" "${target_root}/misc" "${target_root}/theme" || die "Stock-Verzeichnisse konnten nicht vorbereitet werden."
    python3 - "${shell_resource}" "${active_theme}" "${target_root}" <<'PY'
import pathlib
import subprocess
import sys

shell_resource = pathlib.Path(sys.argv[1])
theme_resource = pathlib.Path(sys.argv[2])
target_root = pathlib.Path(sys.argv[3])
resources = {
    "ui/sessionMode.js": (shell_resource, "/org/gnome/shell/ui/sessionMode.js"),
    "ui/panel.js": (shell_resource, "/org/gnome/shell/ui/panel.js"),
    "misc/systemActions.js": (shell_resource, "/org/gnome/shell/misc/systemActions.js"),
    "ui/screenShield.js": (shell_resource, "/org/gnome/shell/ui/screenShield.js"),
    "ui/shellDBus.js": (shell_resource, "/org/gnome/shell/ui/shellDBus.js"),
    "ui/unlockDialog.js": (shell_resource, "/org/gnome/shell/ui/unlockDialog.js"),
    "gdm/authPrompt.js": (shell_resource, "/org/gnome/shell/gdm/authPrompt.js"),
    "gdm/loginDialog.js": (shell_resource, "/org/gnome/shell/gdm/loginDialog.js"),
    "theme/gdm.css": (theme_resource, "/org/gnome/shell/theme/gdm.css"),
}

for relative_path, (resource_file, resource_path) in resources.items():
    content = subprocess.check_output(
        ["gresource", "extract", str(resource_file), resource_path]
    )
    (target_root / relative_path).write_bytes(content)
PY
}

verify_stock_overlay() {
    local target_root="$1"
    local active_theme
    local env_value="/org/gnome/shell=${target_root}"
    active_theme="$(active_theme_path)"

    python3 - "${shell_resource}" "${active_theme}" "${target_root}" <<'PY' || die "Stock-Ressourcenprüfung fehlgeschlagen."
import pathlib
import subprocess
import sys

shell_resource = pathlib.Path(sys.argv[1])
theme_resource = pathlib.Path(sys.argv[2])
target_root = pathlib.Path(sys.argv[3])
resources = {
    "ui/sessionMode.js": (shell_resource, "/org/gnome/shell/ui/sessionMode.js"),
    "ui/panel.js": (shell_resource, "/org/gnome/shell/ui/panel.js"),
    "misc/systemActions.js": (shell_resource, "/org/gnome/shell/misc/systemActions.js"),
    "ui/screenShield.js": (shell_resource, "/org/gnome/shell/ui/screenShield.js"),
    "ui/shellDBus.js": (shell_resource, "/org/gnome/shell/ui/shellDBus.js"),
    "ui/unlockDialog.js": (shell_resource, "/org/gnome/shell/ui/unlockDialog.js"),
    "gdm/authPrompt.js": (shell_resource, "/org/gnome/shell/gdm/authPrompt.js"),
    "gdm/loginDialog.js": (shell_resource, "/org/gnome/shell/gdm/loginDialog.js"),
    "theme/gdm.css": (theme_resource, "/org/gnome/shell/theme/gdm.css"),
}

for relative_path, (resource_file, resource_path) in resources.items():
    expected = subprocess.check_output(
        ["gresource", "extract", str(resource_file), resource_path]
    )
    actual = (target_root / relative_path).read_bytes()
    if actual != expected:
        raise SystemExit(f"Stock-Ressource stimmt nicht überein: {relative_path}")
PY

    run_gjs_check "${env_value}" "const Gio = imports.gi.Gio; for (const path of ['/org/gnome/shell/ui/sessionMode.js', '/org/gnome/shell/ui/panel.js', '/org/gnome/shell/misc/systemActions.js', '/org/gnome/shell/ui/screenShield.js', '/org/gnome/shell/ui/shellDBus.js', '/org/gnome/shell/ui/unlockDialog.js', '/org/gnome/shell/gdm/authPrompt.js', '/org/gnome/shell/gdm/loginDialog.js', '/org/gnome/shell/theme/gdm.css']) { const data = Gio.resources_lookup_data(path, 0); if (data.get_size() === 0) throw new Error('Leere Stock-Ressource: ' + path); }" || die "GResource-Prüfung fehlgeschlagen."
}

prepare_stock_release() {
    local fingerprint
    local release_root
    local candidate
    local output

    prepared_stock=""
    if ! output="$(stock_fingerprint 2>&1)"; then
        refresh_error="${output}"
        return 1
    fi
    fingerprint="${output}"
    release_root="${stock_releases}/${fingerprint}"

    if [[ -d "${release_root}" ]]; then
        if output="$(verify_stock_overlay "${release_root}" 2>&1)"; then
            if output="$(
                (
                    printf '%s\n' "${release_root}" >"${stock_overlay_state}" &&
                    chmod 644 "${stock_overlay_state}"
                ) 2>&1
            )"; then
                prepared_stock="${release_root}"
                return 0
            fi
        fi
        refresh_error="${output}"
        return 1
    fi

    candidate="${candidate_root}/stock-${fingerprint}-${BASHPID}"
    if ! output="$(
        (
            write_stock_overlay "${candidate}" || exit "$?"
            verify_stock_overlay "${candidate}" || exit "$?"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi

    if ! output="$(
        (
            install -d -m755 "${stock_releases}" &&
            mv -- "${candidate}" "${release_root}" &&
            printf '%s\n' "${release_root}" >"${stock_overlay_state}" &&
            chmod 644 "${stock_overlay_state}"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi
    prepared_stock="${release_root}"
}

switch_overlay() {
    local target="$1"
    local pending_link="${overlay_base}/.active-${BASHPID}"

    install -d -m755 "${overlay_base}" "${target}" || die "Overlay-Verzeichnisse konnten nicht vorbereitet werden."
    ln -s -- "${target}" "${pending_link}" || die "Aktivierungslink konnte nicht vorbereitet werden."
    mv -Tf -- "${pending_link}" "${overlay_root}" || die "Overlay konnte nicht aktiviert werden."
}

deactivate_system_integration() {
    if [[ -z "${prepared_stock}" ]]; then
        prepare_stock_release || die "Stock-Overlay konnte nicht vorbereitet werden: ${refresh_error}"
    fi
    switch_overlay "${prepared_stock}"
    remove_dropin_file "${user_shell_dropin_file}" || die "User-Drop-in konnte nicht entfernt werden."
    remove_dropin_file "${gdm_service_dropin_file}" || die "GDM-Drop-in konnte nicht entfernt werden."
    remove_dropin_file "$(gdm_dropin_file)" || die "GDM-User-Drop-in konnte nicht entfernt werden."
    remove_dropin_file "${previous_global_wayland_dropin_file}" || die "Alter User-Drop-in konnte nicht entfernt werden."
    remove_dropin_file "$(previous_gdm_wayland_dropin_file)" || die "Alter GDM-Drop-in konnte nicht entfernt werden."
    restore_greeter_desktop_environment
    systemctl daemon-reload
    reload_managed_user_manager
}

prepare_overlay_release() {
    local fingerprint
    local release_root
    local candidate
    local output

    prepared_overlay=""
    if ! output="$(overlay_fingerprint 2>&1)"; then
        refresh_error="${output}"
        return 1
    fi
    fingerprint="${output}"
    release_root="${overlay_releases}/${fingerprint}"

    if [[ -d "${release_root}" ]]; then
        if output="$(
            (
                verify_overlay_resources generated "${release_root}"
            ) 2>&1
        )"; then
            prepared_overlay="${release_root}"
            return 0
        fi
        refresh_error="${output}"
        return 1
    fi

    candidate="${candidate_root}/${fingerprint}-${BASHPID}"
    if ! output="$(
        (
            write_overlay_sources "${candidate}" || exit "$?"
            verify_overlay_resources generated "${candidate}" || exit "$?"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi

    if ! output="$(
        (
            install -d -m755 "${overlay_releases}" &&
            mv -- "${candidate}" "${release_root}"
        ) 2>&1
    )"; then
        refresh_error="${output}"
        return 1
    fi
    prepared_overlay="${release_root}"
}

activate_overlay_release() {
    local release_root="$1"

    switch_overlay "${release_root}"
    printf '%s\n' "${release_root}" >"${active_overlay_state}" || die "Overlay-Status konnte nicht geschrieben werden."
    chmod 644 "${active_overlay_state}" || die "Overlay-Statusrechte konnten nicht gesetzt werden."
    write_dropins || die "Drop-ins konnten nicht aktiviert werden."
    apply_greeter_desktop_environment || die "Greeter-Umgebung konnte nicht aktiviert werden."
    verify_overlay_resources || die "Aktiviertes Overlay ist ungültig."
    rm -f "${greeter_desktop_state}" || die "Greeter-Status konnte nicht aktualisiert werden."
}

refresh_override() {
    local extension_registered=false
    if [[ -e "${overlay_extension}" || -L "${overlay_extension}" ]]; then
        extension_registered=true
    fi
    write_runtime_state
    print_step "Stock-Overlay prüfen"
    if ! prepare_stock_release; then
        [[ -n "${refresh_error}" ]] || refresh_error="Stock-Overlay konnte nicht erzeugt oder geprüft werden."
        printf '%s\n' "${refresh_error}" >&2
        die "Sicherer Stock-Zustand konnte nicht vorbereitet werden."
    fi

    print_step "Kompatibilität prüfen"
    if ! prepare_overlay_release; then
        [[ -n "${refresh_error}" ]] || refresh_error="Overlay konnte nicht erzeugt oder geprüft werden."
        printf '%s\n' "${refresh_error}" >&2
        if [[ "${extension_registered}" == false ]]; then
            deactivate_system_integration
        fi
        record_refresh_failure "${refresh_error}"
        die "GDM-Anpassung konnte nicht vorbereitet werden."
    fi

    if [[ "${extension_registered}" == true ]]; then
        print_step "Overlay-Erweiterung vorbereiten"
        prepared_overlay="$("${overlay_extension_runner}" prepare "${overlay_extension}" "${overlay_releases}" "${prepared_overlay}")" || die "Overlay-Erweiterung konnte nicht vorbereitet werden; aktive Generation bleibt erhalten."
        (verify_overlay_resources generated "${prepared_overlay}") || die "Erweitertes Overlay ist ungültig; aktive Generation bleibt erhalten."
    fi

    print_step "Overlay atomar aktivieren"
    if ! (activate_overlay_release "${prepared_overlay}"); then
        refresh_error="Overlay konnte nicht atomar aktiviert werden."
        if [[ "${extension_registered}" == false ]]; then
            deactivate_system_integration
        fi
        record_refresh_failure "${refresh_error}"
        die "${refresh_error}"
    fi

    if [[ "${extension_registered}" == true ]]; then
        "${overlay_extension_runner}" commit "${overlay_extension}" "${overlay_releases}" "${prepared_overlay}" || die "Overlay ist aktiviert, Erweiterungsabschluss fehlgeschlagen; Anbieterjournal prüfen."
    fi

    clear_refresh_failure
}

notify_refresh_failure() {
    [[ -f "${failure_state}" ]] || return 0
    [[ -f "${target_user_state}" ]] || return 0
    [[ "$(id -un)" == "$(head -n 1 "${target_user_state}")" ]] || return 0

    local values=()
    mapfile -t values < <(
        python3 - "${failure_state}" <<'PY'
import json
import pathlib
import sys

state = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(state["id"])
print(state["summary"])
print(state["body"])
PY
    )

    local identity="${values[0]}"
    local summary="${values[1]}"
    local body="${values[2]}"
    local state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
    local notified_dir="${state_home}/gdm-greeter-minimalism"
    local notified_state="${notified_dir}/notified"

    if [[ -f "${notified_state}" ]] && [[ "$(head -n 1 "${notified_state}")" == "${identity}" ]]; then
        return 0
    fi

    gdbus call \
        --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "GDM Greeter Minimalism" \
        0 \
        "" \
        "${summary}" \
        "${body}" \
        "[]" \
        "{}" \
        0 >/dev/null

    install -d -m700 "${notified_dir}"
    printf '%s\n' "${identity}" >"${notified_state}"
    chmod 600 "${notified_state}"
}

apply_override() {
    write_runtime_state
    restore_legacy_override_if_needed
    print_step "Greeter-Konfiguration schreiben"
    write_greeter_background
    write_greeter_accent
    write_greeter_input_sources
    write_gdm_profile
    write_greeter_sound_theme
    write_greeter_sound
    print_step "gdm-dconf setzen"
    apply_gdm_background
    apply_gdm_accent
    apply_gdm_input_sources
    refresh_override
    print_step "Shortcut aktualisieren"
    apply_user_shortcut
    print_step "Installation prüfen"
    verify_overlay
}

verify_overlay() {
    resolve_input_sources
    verify_overlay_resources
    if legacy_override_active; then
        die "Legacy-CSS-Override noch aktiv."
    fi

    resolve_target_user
    if [[ -n "${resolved_target_user}" ]]; then
        local screensaver_binding
        local disable_lock_screen
        local shortcut
        local shortcut_path
        local shortcut_command

        screensaver_binding="$(user_gsettings_get "${resolved_target_user}" org.gnome.settings-daemon.plugins.media-keys screensaver)"
        [[ "${screensaver_binding}" == "@as []" ]] || die "Screensaver-Keybind ist nicht deaktiviert: ${screensaver_binding}"
        disable_lock_screen="$(user_gsettings_get "${resolved_target_user}" org.gnome.desktop.lockdown disable-lock-screen)"
        [[ "${disable_lock_screen}" == "false" ]] || die "GNOME-Sessionsperre ist deaktiviert: ${disable_lock_screen}"

        shortcut="$(find_super_l_shortcut "${resolved_target_user}" || true)"
        [[ -n "${shortcut}" ]] || die "Kein Super+L-Shortcut aktiv."
        shortcut_path="${shortcut%%$'\t'*}"
        shortcut_command="${shortcut#*$'\t'}"
        [[ "${shortcut_command}" == "${greeter_command_setting}" ]] || die "Super+L zeigt nicht auf den Greeter: ${shortcut_path} -> ${shortcut_command}"
    fi

    print_installed_summary
}

restore_override() {
    if [[ -e "${overlay_extension}" || -L "${overlay_extension}" ]]; then
        die "Registrierte Overlay-Erweiterung zuerst entfernen; Wiederherstellung abgebrochen."
    fi
    resolve_managed_user
    print_step "Systemintegration entfernen"
    deactivate_system_integration
    print_step "Greeter-Konfiguration entfernen"
    remove_greeter_background
    remove_greeter_accent
    remove_greeter_input_sources
    restore_gdm_profile
    remove_greeter_sound
    remove_greeter_sound_theme
    print_step "gdm-dconf wiederherstellen"
    restore_gdm_background
    restore_gdm_accent
    restore_gdm_input_sources
    print_step "Shortcut und Session wiederherstellen"
    restore_user_shortcut
    restore_legacy_override_if_needed
    rm -f "${active_overlay_state}" "${stock_overlay_state}" "${enabled_state}" "${target_user_state}" "${failure_state}"

    if [[ -f "${user_shell_dropin_file}" ]] || [[ -f "${gdm_service_dropin_file}" ]] || [[ -f "$(gdm_dropin_file)" ]] || [[ -f "${previous_global_wayland_dropin_file}" ]] || [[ -f "$(previous_gdm_wayland_dropin_file)" ]]; then
        die "Hard-Override konnte nicht deaktiviert werden."
    fi
    if legacy_override_active; then
        die "Legacy-CSS-Override ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_input_state}" ]]; then
        die "GDM-Input-State ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_background_state}" ]]; then
        die "GDM-Background-State ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_accent_state}" ]]; then
        die "GDM-Accent-State ist weiterhin aktiv."
    fi
    if [[ -f "${gdm_profile_state}" ]]; then
        die "GDM-Profil-State ist weiterhin aktiv."
    fi
    if [[ -f "${user_shortcut_state}" ]]; then
        die "Shortcut-State ist weiterhin aktiv."
    fi
    if [[ -f "${greeter_desktop_state}" ]]; then
        die "Greeter-Desktop-State ist weiterhin aktiv."
    fi
    if grep -F "G_RESOURCE_OVERLAYS=" "${greeter_desktop_file}" >/dev/null; then
        die "Greeter-Desktop lädt weiterhin G_RESOURCE_OVERLAYS."
    fi
    if grep -F "${greeter_background_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Background-Override ist weiterhin aktiv."
    fi
    if grep -F "${greeter_accent_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Accent-Override ist weiterhin aktiv."
    fi
    if grep -F "${greeter_input_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Input-Override ist weiterhin aktiv."
    fi
    if grep -F "${greeter_sound_begin}" "${greeter_dconf_file}" >/dev/null; then
        die "Greeter-Sound-Override ist weiterhin aktiv."
    fi
    if [[ -e "${greeter_sound_lock_file}" ]] || [[ -e "${greeter_sound_theme_dir}" ]]; then
        die "Greeter-Sound-Artefakte sind weiterhin aktiv."
    fi

    print_restored_summary
}

maybe_restart() {
    local restart_flag="$1"

    if [[ "${restart_flag}" == "1" ]]; then
        print_step "gdm neu starten"
        systemctl restart gdm
    fi
}

main() {
    local command="${1:-}"
    local restart_flag="0"

    setup_colors

    if [[ -z "${command}" ]]; then
        command="$(prompt_action)"
        [[ "${command}" != "exit" ]] || exit 0
        restart_flag="$(prompt_restart "${command}")"
    elif [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        usage
        exit 0
    else
        shift || true
        if [[ "${1:-}" == "--restart" ]]; then
            restart_flag="1"
            shift
        fi
    fi

    [[ "$#" -eq 0 ]] || {
        usage
        exit 1
    }

    case "${command}" in
        apply)
            ensure_root_for_action "${command}" "${restart_flag}"
            require_tools
            acquire_lock
            apply_override
            maybe_restart "${restart_flag}"
            ;;
        verify)
            require_tools
            verify_overlay
            ;;
        lock)
            lock_to_greeter
            ;;
        refresh)
            [[ "$(id -u)" -eq 0 ]] || die "refresh benötigt Root-Rechte."
            if [[ ! -f "${enabled_state}" ]] && [[ ! -f "${user_shortcut_state}" ]]; then
                exit 0
            fi
            require_tools
            acquire_lock
            restore_legacy_override_if_needed
            if [[ -f "${enabled_state}" ]]; then
                write_gdm_profile
                write_greeter_sound_theme
                write_greeter_sound
            fi
            refresh_override
            if [[ -f "${user_shortcut_state}" ]]; then
                apply_user_shortcut
            fi
            ;;
        notify)
            notify_refresh_failure
            ;;
        restore)
            ensure_root_for_action "${command}" "${restart_flag}"
            require_tools
            acquire_lock
            restore_override
            maybe_restart "${restart_flag}"
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
