screen_shield = extract("/org/gnome/shell/ui/screenShield.js")
screen_shield = replace_once(
    screen_shield,
    "import Gio from 'gi://Gio';\n",
    "import Gdm from 'gi://Gdm';\nimport Gio from 'gi://Gio';\n",
    "screenShield.js:Gdm",
)
screen_shield = replace_once(
    screen_shield,
    "    lock(animate) {\n",
    """    lock(animate) {
        if (Main.sessionMode.isGreeter) {
            this._lockSession(animate);
            return Promise.resolve();
        }
        return this.switchToGreeter(animate);
    }

    switchToGreeter(animate = true) {
        if (Main.sessionMode.isGreeter) {
            const request = Promise.reject(new Error('Cannot switch from the greeter'));
            request.catch(logError);
            return request;
        }
        if (this._greeterSwitchDone && this._isLocked && !this._greeterUnlocking)
            return Promise.resolve();
        if (!this._greeterSwitchPromise) {
            this._greeterSwitchPromise = Promise.resolve()
                .then(() => this._lockAndSwitch(animate))
                .finally(() => {
                    this._greeterSwitchPromise = null;
                });
            this._greeterSwitchPromise.catch(logError);
        }
        return this._greeterSwitchPromise;
    }

    async _lockAndSwitch(animate) {
        let shownId = 0;
        let lockedId = 0;
        let timeoutId = 0;
        let deactivatedId = 0;
        try {
            await new Promise((resolve, reject) => {
                let lockReturned = false;
                let lockStarted = false;
                const ready = () => {
                    if (!lockReturned ||
                        this._lockScreenState !== MessageTray.State.SHOWN)
                        return;
                    resolve();
                };
                shownId = this.connect('lock-screen-shown', ready);
                lockedId = this.connect('locked-changed', () => {
                    if (lockStarted && !this._isLocked)
                        reject(new Error('Session unlocked before the greeter switch'));
                });
                timeoutId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 15000, () => {
                    timeoutId = 0;
                    reject(new Error('Session lock did not reach a painted shield'));
                    return GLib.SOURCE_REMOVE;
                });
                const startLock = () => {
                    lockStarted = true;
                    try {
                        this._lockSession(false);
                        lockReturned = true;
                        if (!this._isLocked || !this._grab || !this.actor.visible)
                            reject(new Error('Session could not be locked'));
                        else
                            ready();
                    } catch (error) {
                        reject(error);
                    }
                };
                if (this._greeterUnlocking) {
                    deactivatedId = this.connect('deactivated', () => {
                        this.disconnect(deactivatedId);
                        deactivatedId = 0;
                        startLock();
                    });
                } else {
                    startLock();
                }
            });
            if (!this._isLocked || !this._grab || !this.actor.visible || this._greeterUnlocking ||
                this._lockScreenState !== MessageTray.State.SHOWN)
                throw new Error('Session is not fully locked');
            if (!Gdm.goto_login_session_sync(null))
                throw new Error('GDM login session could not be activated');
            this._greeterSwitchDone = true;
        } finally {
            if (shownId)
                this.disconnect(shownId);
            if (lockedId)
                this.disconnect(lockedId);
            if (timeoutId)
                GLib.source_remove(timeoutId);
            if (deactivatedId)
                this.disconnect(deactivatedId);
        }
    }

    _lockSession(animate) {
""",
    "screenShield.js:lock",
)
