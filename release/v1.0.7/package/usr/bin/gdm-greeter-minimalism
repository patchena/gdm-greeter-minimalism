write_greeter_sound_theme() {
    local event

    install -d -m755 "${greeter_sound_theme_dir}/stereo"
    printf '%s\n' \
        '[Sound Theme]' \
        'Name=GDM Greeter Minimalism' \
        'Directories=stereo' \
        '' \
        '[stereo]' \
        'OutputProfile=stereo' >"${greeter_sound_theme_dir}/index.theme"
    chmod 644 "${greeter_sound_theme_dir}/index.theme"
    for event in "${greeter_sound_events[@]}"; do
        install -m644 /dev/null "${greeter_sound_theme_dir}/stereo/${event}.disabled"
    done
}

remove_greeter_sound_theme() {
    local event

    for event in "${greeter_sound_events[@]}"; do
        rm -f "${greeter_sound_theme_dir}/stereo/${event}.disabled"
    done
    rm -f "${greeter_sound_theme_dir}/index.theme"
    if [[ -d "${greeter_sound_theme_dir}/stereo" ]]; then
        rmdir "${greeter_sound_theme_dir}/stereo" || die "Sound-Ereignisverzeichnis konnte nicht entfernt werden."
    fi
    if [[ -d "${greeter_sound_theme_dir}" ]]; then
        rmdir "${greeter_sound_theme_dir}" || die "Sound-Theme-Verzeichnis konnte nicht entfernt werden."
    fi
}

backup_gdm_input_sources() {
    [[ -f "${gdm_input_state}" ]] && return 0

    python3 - "${gdm_input_state}" <<'PY'
import json
import pathlib
import subprocess
import sys

state_path = pathlib.Path(sys.argv[1])
keys = {
    "sources": "/org/gnome/desktop/input-sources/sources",
    "mru-sources": "/org/gnome/desktop/input-sources/mru-sources",
    "xkb-options": "/org/gnome/desktop/input-sources/xkb-options",
}
state = {}

for name, key in keys.items():
    proc = subprocess.run(
        ["runuser", "-u", "gdm", "--", "dbus-run-session", "dconf", "read", key],
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        raise SystemExit(proc.stderr.strip() or f"dconf read fehlgeschlagen: {key}")
    value = proc.stdout.strip()
    state[name] = value if value else None

state_path.write_text(json.dumps(state), encoding="utf-8")
PY
}

apply_gdm_input_sources() {
    backup_gdm_input_sources
    run_gdm_dconf_write /org/gnome/desktop/input-sources/sources "${resolved_sources}"
    run_gdm_dconf_write /org/gnome/desktop/input-sources/mru-sources "${resolved_mru_sources}"
    run_gdm_dconf_write /org/gnome/desktop/input-sources/xkb-options "${resolved_xkb_options}"
}

backup_gdm_background() {
    [[ -f "${gdm_background_state}" ]] && return 0

    python3 - "${gdm_background_state}" <<'PY'
import json
import pathlib
import subprocess
import sys

state_path = pathlib.Path(sys.argv[1])
keys = {
