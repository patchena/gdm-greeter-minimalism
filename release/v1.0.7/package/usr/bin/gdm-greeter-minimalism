            this._lockScreenUpdateId = global.stage.connect('after-update', stage => {
                if (!this.actor.visible ||
                    this._lockScreenState !== MessageTray.State.SHOWING)
                    return;
                const views = stage.peek_stage_views();
                if (!views.length || !views.every(current => painted.has(current)))
                    return;
                global.stage.disconnect(this._lockScreenPaintId);
                global.stage.disconnect(this._lockScreenUpdateId);
                global.stage.disconnect(this._lockScreenViewsId);
                this._lockScreenPaintId = 0;
                this._lockScreenUpdateId = 0;
                this._lockScreenViewsId = 0;
                this._completeLockScreenShown({...params, animateFade: false});
            });
            global.stage.queue_redraw();
            return;
        }
        this._completeLockScreenShown(params);
    }

    _completeLockScreenShown(params) {
""",
    "screenShield.js:paintBeforeActive",
)
screen_shield = replace_once(
    screen_shield,
    "    _continueDeactivate(animate) {\n",
    """    _continueDeactivate(animate) {
        if (this._lockScreenPaintId) {
            global.stage.disconnect(this._lockScreenPaintId);
            this._lockScreenPaintId = 0;
        }
        if (this._lockScreenUpdateId) {
            global.stage.disconnect(this._lockScreenUpdateId);
            this._lockScreenUpdateId = 0;
